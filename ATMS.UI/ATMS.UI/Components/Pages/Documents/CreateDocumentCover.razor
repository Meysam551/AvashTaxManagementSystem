@page "/document-cover/create"
@using MudBlazor
@using System.Globalization
@rendermode RenderMode.InteractiveServer
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject ILogger<CreateDocumentCover> Logger
@namespace ATMS.UI.Components.Pages

<h3>ثبت سند جدید</h3>

@if (_isLoading)
{
    <div class="text-center my-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">در حال بارگذاری...</span>
        </div>
    </div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />

        <div class="row">
            <div class="col-md-3">
                <div class="mb-3">
                    <label class="form-label">تاریخ سند *</label>
                    <InputText @bind-Value="PersianDateString"
                               class="form-control"
                               @attributes="GetInputAttributes()"
                               placeholder="۱۴۰۳/۱۰/۱۸" />
                    @if (_dateError)
                    {
                        <div class="invalid-feedback">قالب تاریخ باید ۱۴۰۳/۱۰/۱۸ باشد</div>
                    }
                </div>
            </div>

            <div class="col-md-3">
                <div class="mb-3">
                    <label class="form-label">سال مالی *</label>
                    <InputNumber @bind-Value="_model.FiscalYear"
                                 class="form-control"
                                 min="1400"
                                 max="2030" />
                    <ValidationMessage For="@(() => _model.FiscalYear)" />
                </div>
            </div>

            <div class="col-md-3">
                <div class="mb-3">
                    <label class="form-label">نوع سند *</label>
                    <InputSelect @bind-Value="_model.DocumentType"
                                 class="form-select">
                        <option value="">-- انتخاب کنید --</option>
                        @foreach (var item in DocumentTypeOptions)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => _model.DocumentType)" />
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">شرح سند *</label>
            <InputTextArea @bind-Value="_model.Description"
                           class="form-control"
                           rows="3"
                           placeholder="شرح مختصر سند..." />
            <ValidationMessage For="@(() => _model.Description)" />
        </div>

        <div class="alert alert-info">
            <small>
                <strong>راهنما:</strong><br />
                @if (_model.DocumentType.HasValue)
                {
                    var selectedType = (DocumentTypeEnum)_model.DocumentType.Value;
                    @selectedType.GetDescription()
                }
                else
                {
                    <text>یک نوع سند انتخاب کنید تا راهنمای آن نمایش داده شود.</text>
                }
            </small>
        </div>

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary"
                    disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                ثبت سند
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="Cancel"
                    disabled="@_isSubmitting">
                انصراف
            </button>
        </div>
    </EditForm>
}